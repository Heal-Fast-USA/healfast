CRATER_ATOMFEED_DB_NAME=crater_atomfeed
CRATER_ATOMFEED_DB_USERNAME=crater_atomfeed
CRATER_ATOMFEED_DB_PASSWORD=HealFast2024Secure
CRATER_USERNAME=admin@healfastusa.org
