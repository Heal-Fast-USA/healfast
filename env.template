# HealFast USA - Bahmni Docker Environment Configuration
# Copy this file to .env in your bahmni-lite or bahmni-standard directory.
# CHANGE ALL PASSWORDS after first install (then remove from GitHub if desired).

# ============================================
# Docker Compose Profiles
# ============================================
COMPOSE_PROFILES=emr,bahmni-lite

# Required by compose file (Loki not used; default logging is used)
LOKI_URL=http://127.0.0.1:3100

# ============================================
# Timezone
# ============================================
TZ=America/New_York

# ============================================
# Restart Policy
# ============================================
RESTART_POLICY=unless-stopped

# ============================================
# HealFast Branding Path (required for override when run from bahmni-lite)
# Must be absolute path to healfast-branding directory on the server.
# ============================================
HEALFAST_BRANDING_PATH=/opt/bahmni-docker/healfast-branding

# ============================================
# Configuration Volume Path
# ============================================
CONFIG_VOLUME=/opt/bahmni-docker/healfast-branding/config
# Second copy for bahmni-config (must be a real copy, not a symlink). Sync with: rsync -a --delete "$(dirname $CONFIG_VOLUME)/config/" "$(dirname $CONFIG_VOLUME)/config_etc/"
CONFIG_VOLUME_ETC=/opt/bahmni-docker/healfast-branding/config_etc

# ============================================
# SSL Certificate Path
# ============================================
CERTIFICATE_PATH=./healfast-branding/ssl

# ============================================
# Proxy Configuration
# ============================================
PROXY_IMAGE_TAG=latest

# ============================================
# Bahmni Config Image
# ============================================
CONFIG_IMAGE_TAG=latest

# ============================================
# OpenMRS Configuration
# ============================================
OPENMRS_IMAGE_TAG=latest
OPENMRS_HOST=openmrs
OPENMRS_PORT=8080
OPENMRS_DB_HOST=openmrsdb
OPENMRS_DB_NAME=openmrs
OPENMRS_DB_USERNAME=openmrs
OPENMRS_DB_PASSWORD=CHANGE_ME_OPENMRS_DB_PASSWORD
OPENMRS_DB_CREATE_TABLES=true
OPENMRS_DB_AUTO_UPDATE=true
OPENMRS_MODULE_WEB_ADMIN=true
OPENMRS_DOCKER_ENV=production
OPENMRS_DB_IMAGE_NAME=bahmni/openmrs-db:1.0.0-lite-mysql5.6
OPENMRS_DB_SQL_MODES=STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION
OPENMRS_ATOMFEED_USER=atomfeed
OPENMRS_ATOMFEED_PASSWORD=CHANGE_ME_ATOMFEED_PASSWORD

# ============================================
# Java Memory Options
# ============================================
OMRS_JAVA_SERVER_OPTS=-Xms512m -Xmx2048m
OMRS_JAVA_MEMORY_OPTS=-Xms512m -Xmx2048m

# ============================================
# Bahmni Web Configuration
# ============================================
BAHMNI_WEB_IMAGE_TAG=latest

# ============================================
# Bahmni Apps Frontend
# ============================================
BAHMNI_APPS_FRONTEND_IMAGE_TAG=latest

# ============================================
# Implementer Interface
# ============================================
IMPLEMENTER_INTERFACE_IMAGE_TAG=latest

# ============================================
# Reports Configuration
# ============================================
REPORTS_IMAGE_TAG=latest
REPORTS_DB_SERVER=reportsdb
REPORTS_DB_NAME=bahmni_reports
REPORTS_DB_USERNAME=bahmni_reports
REPORTS_DB_PASSWORD=CHANGE_ME_REPORTS_DB_PASSWORD
REPORTS_DB_IMAGE_NAME=mysql:5.7
ICD10_LITE_INDICATOR=true

# ============================================
# Patient Documents
# ============================================
PATIENT_DOCUMENTS_TAG=latest

# ============================================
# Appointments
# ============================================
APPOINTMENTS_IMAGE_TAG=latest

# ============================================
# MySQL Root Password
# ============================================
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# ============================================
# Email Configuration (Optional)
# ============================================
SEND_MAIL=false
MAIL_TRANSPORT_PROTOCOL=smtp
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_SSL_ENABLE=false
MAIL_DEBUG=false
MAIL_FROM=noreply@healfastusa.org
MAIL_USER=
MAIL_PASSWORD=

# ============================================
# Database Connection Pool
# ============================================
OMRS_C3P0_MAX_SIZE=50

# ============================================
# Concept UUIDs
# ============================================
WEIGHT_CONCEPT_UUID=
HEIGHT_CONCEPT_UUID=

# ============================================
# Lucene Configuration
# ============================================
LUCENE_MATCH_TYPE=fuzzy

# ============================================
# Document Size Limit
# ============================================
DOCUMENT_MAX_SIZE_MB=10

# ============================================
# Server (subdomains: clinic + staff @ healfastusa.org)
# ============================================
SERVER_IP=69.30.247.92
HEALFAST_CLINIC_URL=https://clinic.healfastusa.org
HEALFAST_STAFF_URL=https://staff.healfastusa.org

# ============================================
# Bahmni Lab
# ============================================
BAHMNI_LAB_IMAGE_TAG=latest

# ============================================
# Metabase (required by compose even if profile not used)
# ============================================
METABASE_POSTGRES_IMAGE_TAG=15.1
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=HealFast2024Secure
METABASE_DB_HOST=metabasedb
