# HealFast USA - Bahmni Docker Environment Configuration
# Copy this file to .env in your bahmni-lite or bahmni-standard directory
# and update the values as needed

# ============================================
# Docker Compose Profiles
# ============================================
COMPOSE_PROFILES=emr,bahmni-lite

# Required by compose file (Loki not used; default logging is used)
LOKI_URL=http://127.0.0.1:3100

# ============================================
# Timezone
# ============================================
TZ=America/New_York

# ============================================
# Restart Policy
# ============================================
RESTART_POLICY=unless-stopped

# ============================================
# Configuration Volume Path
# ============================================
CONFIG_VOLUME=./healfast-branding/config

# ============================================
# SSL Certificate Path
# ============================================
CERTIFICATE_PATH=./healfast-branding/ssl

# ============================================
# Proxy Configuration
# ============================================
PROXY_IMAGE_TAG=latest

# ============================================
# Bahmni Config Image
# ============================================
CONFIG_IMAGE_TAG=1.0.0

# ============================================
# OpenMRS Configuration
# ============================================
OPENMRS_IMAGE_TAG=1.0.0
OPENMRS_HOST=openmrs
OPENMRS_PORT=8080
OPENMRS_DB_HOST=openmrsdb
OPENMRS_DB_NAME=openmrs
OPENMRS_DB_USERNAME=openmrs
OPENMRS_DB_PASSWORD=CHANGE_ME_OPENMRS_DB_PASSWORD
OPENMRS_DB_CREATE_TABLES=true
OPENMRS_DB_AUTO_UPDATE=true
OPENMRS_MODULE_WEB_ADMIN=true
OPENMRS_DOCKER_ENV=production
OPENMRS_DB_IMAGE_NAME=bahmni/mysql:5.7
OPENMRS_DB_SQL_MODES=STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION
OPENMRS_ATOMFEED_USER=atomfeed
OPENMRS_ATOMFEED_PASSWORD=CHANGE_ME_ATOMFEED_PASSWORD

# ============================================
# Java Memory Options
# ============================================
OMRS_JAVA_SERVER_OPTS=-Xms512m -Xmx2048m
OMRS_JAVA_MEMORY_OPTS=-Xms512m -Xmx2048m

# ============================================
# Bahmni Web Configuration
# ============================================
BAHMNI_WEB_IMAGE_TAG=1.0.0

# ============================================
# Bahmni Apps Frontend
# ============================================
BAHMNI_APPS_FRONTEND_IMAGE_TAG=1.0.0

# ============================================
# Implementer Interface
# ============================================
IMPLEMENTER_INTERFACE_IMAGE_TAG=1.0.0

# ============================================
# Reports Configuration
# ============================================
REPORTS_IMAGE_TAG=1.0.0
REPORTS_DB_SERVER=reportsdb
REPORTS_DB_NAME=bahmni_reports
REPORTS_DB_USERNAME=bahmni_reports
REPORTS_DB_PASSWORD=CHANGE_ME_REPORTS_DB_PASSWORD
REPORTS_DB_IMAGE_NAME=bahmni/mysql:5.7
ICD10_LITE_INDICATOR=true

# ============================================
# Patient Documents
# ============================================
PATIENT_DOCUMENTS_TAG=1.0.0

# ============================================
# Appointments
# ============================================
APPOINTMENTS_IMAGE_TAG=1.0.0

# ============================================
# MySQL Root Password
# ============================================
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# ============================================
# Email Configuration (Optional)
# ============================================
SEND_MAIL=false
MAIL_TRANSPORT_PROTOCOL=smtp
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_SSL_ENABLE=false
MAIL_DEBUG=false
MAIL_FROM=noreply@healfastusa.org
MAIL_USER=
MAIL_PASSWORD=

# ============================================
# Database Connection Pool
# ============================================
OMRS_C3P0_MAX_SIZE=50

# ============================================
# Concept UUIDs
# ============================================
WEIGHT_CONCEPT_UUID=
HEIGHT_CONCEPT_UUID=

# ============================================
# Lucene Configuration
# ============================================
LUCENE_MATCH_TYPE=fuzzy

# ============================================
# Document Size Limit
# ============================================
DOCUMENT_MAX_SIZE_MB=10

# ============================================
# Domain Configuration
# ============================================
CLINIC_DOMAIN=clinic.healfastusa.org
STAFF_DOMAIN=staff.healfastusa.org
