CRATER_DB_USERNAME=crater
CRATER_DB_PASSWORD=HealFast2024Secure
CRATER_SANCTUM_STATEFUL_DOMAINS=clinic.healfastusa.org,staff.healfastusa.org
CRATER_SESSION_DOMAIN=.healfastusa.org
CRATER_AUTO_INSTALL=true
CRATER_ADMIN_NAME=Super Admin
CRATER_ADMIN_EMAIL=admin@healfastusa.org
CRATER_ADMIN_PASSWORD=HealFast2024Secure
CRATER_COMPANY_NAME=HealFast USA
CRATER_COMPANY_SLUG=healfast
# Must exist in Crater's countries table (1 or 231 often work; 566 caused FK error)
